    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Mobile menu toggle
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            mobileMenuButton.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Intersection Observer for animations
            const observerOptions = {
                root: null,
                rootMargin: '0px',
                threshold: 0.1
            };

            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.section-fade-in').forEach(el => {
                observer.observe(el);
            });

            // --- Chart.js Implementation ---
            const chartObserver = new IntersectionObserver((entries, obs) => {
                const entry = entries[0];
                if (entry.isIntersecting) {
                    renderSalesChart();
                    obs.unobserve(entry.target);
                }
            }, { threshold: 0.5 });

            const chartCanvas = document.getElementById('salesChart');
            if(chartCanvas) {
                chartObserver.observe(chartCanvas);
            }
            
            function renderSalesChart() {
                const ctx = chartCanvas.getContext('2d');
                
                const salesGradient = ctx.createLinearGradient(0, 0, 0, 450);
                salesGradient.addColorStop(0, 'rgba(255, 142, 49, 0.5)');
                salesGradient.addColorStop(1, 'rgba(255, 142, 49, 0)');

                const salesData = [12000, 19000, 25000, 31000, 42000, 58000, 65000, 75000, 88000, 105000, 120000, 145000];
                const adSpendData = [1500, 2200, 2800, 3500, 4100, 4800, 5500, 6200, 7000, 8200, 9500, 11000];


                const salesChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'],
                        datasets: [
                        {
                            label: 'متوسط المبيعات (ريال)',
                            data: salesData,
                            backgroundColor: salesGradient,
                            borderColor: '#FF8E31',
                            borderWidth: 3,
                            pointBackgroundColor: '#FF8E31',
                            pointBorderColor: '#111827',
                            pointHoverBackgroundColor: '#fff',
                            pointHoverBorderColor: '#FF8E31',
                            pointRadius: 5,
                            pointBorderWidth: 2,
                            tension: 0.4,
                            fill: true,
                        },
                        {
                            label: 'تكلفة الإعلانات (ريال)',
                            data: adSpendData,
                            backgroundColor: 'transparent',
                            borderColor: '#6B7280',
                            borderWidth: 2,
                            pointBackgroundColor: '#6B7280',
                            pointRadius: 5,
                            tension: 0.4,
                            borderDash: [5, 5],
                            fill: false,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 2000,
                            easing: 'easeInOutQuart'
                        },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'bottom',
                                labels: {
                                    color: '#D1D5DB',
                                    font: { size: 14, family: 'Tajawal' },
                                    padding: 20,
                                    usePointStyle: true,
                                    pointStyle: 'circle'
                                }
                            },
                             tooltip: {
                                mode: 'index',
                                intersect: false,
                                backgroundColor: '#111827',
                                titleFont: { size: 16, family: 'Tajawal' },
                                bodyFont: { size: 14, family: 'Tajawal' },
                                padding: 12,
                                cornerRadius: 8,
                                displayColors: true,
                                borderColor: '#374151',
                                borderWidth: 1,
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.parsed.y !== null) {
                                            label += new Intl.NumberFormat('ar-SA', { style: 'currency', currency: 'SAR' }).format(context.parsed.y);
                                        }
                                        return label;
                                    }
                                }
                            },
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    color: '#9CA3AF',
                                    font: { size: 12, family: 'Tajawal' },
                                    callback: function(value) {
                                        if (value >= 1000) return value / 1000 + ' ألف';
                                        return value;
                                    }
                                },
                                grid: {
                                    color: '#374151'
                                }
                            },
                            x: {
                                ticks: {
                                    color: '#9CA3AF',
                                    font: { size: 12, family: 'Tajawal' }
                                },
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }


            // Separate observer for the stats section to only fire once
            const statsObserver = new IntersectionObserver((entries, obs) => {
                 entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateNumbers();
                        obs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.5 });
            
            const statsSection = document.getElementById('stats');
            if(statsSection) {
                statsObserver.observe(statsSection);
            }


            // Animate numbers on scroll
            function animateNumbers() {
                document.querySelectorAll('#stats h3').forEach(counter => {
                    const target = +counter.getAttribute('data-target');
                    const duration = 2000;
                    const startTime = performance.now();

                    const step = (currentTime) => {
                        const elapsedTime = currentTime - startTime;
                        const progress = Math.min(elapsedTime / duration, 1);
                        counter.innerText = Math.floor(progress * target).toLocaleString('ar-EG');
                        if (progress < 1) {
                            requestAnimationFrame(step);
                        } else {
                            counter.innerText = target.toLocaleString('ar-EG');
                        }
                    };
                    requestAnimationFrame(step);
                });
            }

            // Gemini API functionality
            const generateBtn = document.getElementById('generateBtn');
            const resultContainer = document.getElementById('result-container');
            const geminiResultDiv = document.getElementById('gemini-result');
            const errorMessageDiv = document.getElementById('error-message');
            const loader = document.getElementById('loader');
            const btnText = document.getElementById('btn-text');
            const copyBtn = document.getElementById('copyBtn');

            generateBtn.addEventListener('click', async () => {
                const productName = document.getElementById('productName').value;
                const productKeywords = document.getElementById('productKeywords').value;

                if (!productName || !productKeywords) {
                    showError('الرجاء إدخال اسم المنتج والمميزات.');
                    return;
                }
                
                toggleLoading(true);

                const systemPrompt = "You are an expert Amazon copywriter specializing in the Saudi Arabian market. Your goal is to create compelling, SEO-friendly product listings in Arabic. The output should be professional and persuasive.";
                const userQuery = `اكتب وصف منتج احترافي لمنصة أمازون السعودية.\nاسم المنتج: ${productName}\nالمميزات والكلمات المفتاحية: ${productKeywords}\n\nالناتج يجب أن يكون بالتنسيق التالي:\n- عنوان جذاب\n- 5 نقاط رئيسية (bullet points) تبدأ كل نقطة برمز تعبيري مناسب.\n- فقرة وصفية قصيرة (لا تزيد عن 3-4 أسطر).`;
                
                try {
                    const result = await callGeminiAPI(systemPrompt, userQuery);
                    displayResult(result);
                } catch (error) {
                    console.error("Error calling Gemini API:", error);
                    showError('حدث خطأ أثناء إنشاء الوصف. الرجاء المحاولة مرة أخرى.');
                } finally {
                    toggleLoading(false);
                }
            });

            copyBtn.addEventListener('click', () => {
                const textToCopy = geminiResultDiv.innerText;
                const textArea = document.createElement("textarea");
                textArea.value = textToCopy;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    copyBtn.textContent = 'تم النسخ!';
                    setTimeout(() => { copyBtn.textContent = 'نسخ'; }, 2000);
                } catch (err) {
                    console.error('Failed to copy text: ', err);
                }
                document.body.removeChild(textArea);
            });

            async function callGeminiAPI(systemPrompt, userQuery) {
                const apiKey = ""; // Canvas will provide the key
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;

                const payload = {
                    contents: [{ parts: [{ text: userQuery }] }],
                    systemInstruction: { parts: [{ text: systemPrompt }] },
                };
                
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error(`API call failed: ${response.status}`);

                const result = await response.json();
                const text = result.candidates?.[0]?.content?.parts?.[0]?.text;

                if (text) {
                     return text;
                } else {
                    throw new Error("Invalid response structure from API.");
                }
            }
            
            function displayResult(text) {
                geminiResultDiv.innerText = text;
                resultContainer.classList.remove('hidden');
                errorMessageDiv.classList.add('hidden');
            }

            function showError(message) {
                 errorMessageDiv.textContent = message;
                 errorMessageDiv.classList.remove('hidden');
                 resultContainer.classList.add('hidden');
            }

            function toggleLoading(isLoading) {
                btnText.classList.toggle('hidden', isLoading);
                loader.classList.toggle('hidden', !isLoading);
                generateBtn.disabled = isLoading;
            }
        });
    </script>
