    <!-- Footer -->
    <footer class="bg-brand-dark py-8 border-t border-brand-gray">
        <div class="container mx-auto px-6 text-center text-gray-500">
            <p>&copy; 2025 جميع الحقوق محفوظة لـ Experts-Amazon.</p>
        </div>
